    <item>
      <title>Version 1.4.0</title>
      <pubDate>Tue, 28 Jan 2026 08:00:00 -0500</pubDate>
      <sparkle:version>140</sparkle:version>
      <sparkle:shortVersionString>1.4.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[
        <h2>What's New in 1.4</h2>
        <ul>
          <li><strong>Save Control:</strong> New option to disable automatic screenshot saving</li>
          <li><strong>Keyboard Hint:</strong> Shows copy shortcut when auto-copy is disabled</li>
          <li><strong>About Dialog:</strong> Cleaner layout with GitHub button</li>
        </ul>
      ]]></description>
