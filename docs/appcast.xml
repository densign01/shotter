      <sparkle:version>110</sparkle:version>
      <sparkle:shortVersionString>1.1.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[
        <h2>What's New in 1.1</h2>
        <ul>
          <li><strong>Direct Copy:</strong> Hold Option while capturing to copy directly to clipboard (skips overlay)</li>
          <li><strong>Overlay Position:</strong> Choose between bottom-left or bottom-right in Preferences</li>
          <li><strong>Auto-Updates:</strong> Check for Updates from the menu bar</li>
        </ul>
      ]]></description>
