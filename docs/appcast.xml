    <item>
      <title>Version 1.3.0</title>
      <pubDate>Mon, 27 Jan 2026 16:45:00 -0500</pubDate>
      <sparkle:version>130</sparkle:version>
      <sparkle:shortVersionString>1.3.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[
        <h2>What's New in 1.3</h2>
        <ul>
          <li><strong>Terminal Support:</strong> Clipboard now includes file URL for inline image display in Ghostty, iTerm2, etc.</li>
          <li><strong>Overlay Fix:</strong> Screenshot overlay no longer shows square corners at edges</li>
          <li><strong>About Dialog:</strong> Now shows build number for easier debugging</li>
        </ul>
      ]]></description>
